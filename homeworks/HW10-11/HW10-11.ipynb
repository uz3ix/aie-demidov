   "source": [
    "def append_run(row):\n",
    "    rows = []\n",
    "    if RUNS_CSV.exists():\n",
    "        with RUNS_CSV.open('r', newline='', encoding='utf-8') as f:\n",
    "            rows = list(csv.DictReader(f))\n",
    "    rows = [r for r in rows if r['experiment_id'] != row['experiment_id']]\n",
    "    rows.append({k: row.get(k, '') for k in RUNS_COLUMNS})\n",
    "    rows = sorted(rows, key=lambda x: x['experiment_id'])\n",
    "    with RUNS_CSV.open('w', newline='', encoding='utf-8') as f:\n",
    "        writer = csv.DictWriter(f, fieldnames=RUNS_COLUMNS)\n",
    "        writer.writeheader()\n",
    "        writer.writerows(rows)\n",
    "\n",
    "def denorm(x):\n",
    "    mean = torch.tensor(IMAGENET_MEAN).view(3, 1, 1)\n",
    "    std = torch.tensor(IMAGENET_STD).view(3, 1, 1)\n",
    "    return (x.cpu() * std + mean).clamp(0, 1)\n",
    "\n",
    "def make_split(n, val_fraction=0.2, seed=SEED):\n",
    "    g = torch.Generator().manual_seed(seed)\n",
    "    perm = torch.randperm(n, generator=g).tolist()\n",
    "    val_size = int(n * val_fraction)\n",
    "    return perm[val_size:], perm[:val_size]\n",
    "\n",
    "class IndexedDataset(Dataset):\n",
    "    def __init__(self, base_ds, indices, transform=None, target_transform=None):\n",
    "        self.base_ds = base_ds\n",
    "        self.indices = list(indices)\n",
    "        self.transform = transform\n",
    "        self.target_transform = target_transform\n",
    "    def __len__(self):\n",
    "        return len(self.indices)\n",
    "    def __getitem__(self, idx):\n",
    "        x, y = self.base_ds[self.indices[idx]]\n",
    "        if self.transform is not None:\n",
    "            x = self.transform(x)\n",
    "        if self.target_transform is not None:\n",
    "            y = self.target_transform(y)\n",
    "        return x, y\n",
    "\n",
    "def collate_detection(batch):\n",
    "    images, targets = zip(*batch)\n",
    "    return list(images), list(targets)\n",
    "\n",
    "COCO_NAME_TO_ID = {'Pedestrian': 1, 'Person_sitting': 1, 'Cyclist': 2, 'Car': 3, 'Van': 3, 'Truck': 8, 'Tram': 7}\n",
    "\n",
    "def kitti_target_to_detection(target_list):\n",
    "    boxes, labels = [], []\n",
    "    for obj in target_list:\n",
    "        obj_type = obj['type']\n",
    "        if obj_type not in COCO_NAME_TO_ID:\n",
    "            continue\n",
    "        x1, y1, x2, y2 = obj['bbox']\n",
    "        if x2 <= x1 or y2 <= y1:\n",
    "            continue\n",
    "        boxes.append([x1, y1, x2, y2])\n",
    "        labels.append(COCO_NAME_TO_ID[obj_type])\n",
    "    if boxes:\n",
    "        boxes = torch.tensor(boxes, dtype=torch.float32)\n",
    "        labels = torch.tensor(labels, dtype=torch.int64)\n",
    "    else:\n",
    "        boxes = torch.zeros((0, 4), dtype=torch.float32)\n",
    "        labels = torch.zeros((0,), dtype=torch.int64)\n",
    "    return {'boxes': boxes, 'labels': labels}\n",
    "\n",
    "class KittiDetectionSubset(Dataset):\n",
    "    def __init__(self, base_ds, indices, image_transform=None):\n",
    "        self.base_ds = base_ds\n",
    "        self.indices = list(indices)\n",
    "        self.image_transform = image_transform\n",
    "    def __len__(self):\n",
    "        return len(self.indices)\n",
    "    def __getitem__(self, idx):\n",
    "        image, target = self.base_ds[self.indices[idx]]\n",
    "        if self.image_transform is not None:\n",
    "            image = self.image_transform(image)\n",
    "        target = kitti_target_to_detection(target)\n",
    "        return image, target\n",
    "\n",
    "def greedy_match(pred_boxes, pred_labels, gt_boxes, gt_labels, iou_threshold=0.5):\n",
    "    if len(pred_boxes) == 0 and len(gt_boxes) == 0:\n",
    "        return 0, 0, 0, []\n",
    "    if len(pred_boxes) == 0:\n",
    "        return 0, 0, len(gt_boxes), []\n",
    "    if len(gt_boxes) == 0:\n",
    "        return 0, len(pred_boxes), 0, []\n",
    "    ious = box_iou(pred_boxes, gt_boxes)\n",
    "    matches = []\n",
    "    used_pred, used_gt = set(), set()\n",
    "    candidates = []\n",
    "    for i in range(len(pred_boxes)):\n",
    "        for j in range(len(gt_boxes)):\n",
    "            if pred_labels[i].item() == gt_labels[j].item() and ious[i, j].item() >= iou_threshold:\n",
    "                candidates.append((ious[i, j].item(), i, j))\n",
    "    candidates.sort(reverse=True, key=lambda x: x[0])\n",
    "    for iou_val, i, j in candidates:\n",
    "        if i in used_pred or j in used_gt:\n",
    "            continue\n",
    "        used_pred.add(i)\n",
    "        used_gt.add(j)\n",
    "        matches.append(iou_val)\n",
    "    tp = len(matches)\n",
    "    fp = len(pred_boxes) - tp\n",
    "    fn = len(gt_boxes) - tp\n",
    "    return tp, fp, fn, matches\n",
    "\n",
    "def draw_box_set(ax, image_tensor, boxes, color='red', title=''):\n",
    "    ax.imshow(np.transpose(denorm(image_tensor).numpy(), (1, 2, 0)))\n",
    "    for box in boxes:\n",
    "        x1, y1, x2, y2 = box\n",
    "        rect = patches.Rectangle((x1, y1), x2 - x1, y2 - y1, linewidth=2, edgecolor=color, facecolor='none')\n",
    "        ax.add_patch(rect)\n",
    "    ax.set_title(title)\n",
    "    ax.axis('off')\n"
   ]
  },
