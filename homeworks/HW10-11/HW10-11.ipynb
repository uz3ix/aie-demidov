    "})\n",
    "\n",
    "num_examples = min(3, len(v1['images']))\n",
    "fig, axes = plt.subplots(num_examples, 4, figsize=(16, 4 * num_examples))\n",
    "if num_examples == 1:\n",
    "    axes = np.expand_dims(axes, axis=0)\n",
    "for i in range(num_examples):\n",
