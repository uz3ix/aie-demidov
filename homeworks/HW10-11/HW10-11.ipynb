    "    draw_box_set(axes[i, 1], v1['images'][i], v1['targets'][i]['boxes'].numpy(), color='lime', title='ground truth')\n",
    "    draw_box_set(axes[i, 2], v1['images'][i], v1['preds'][i]['boxes'].numpy(), color='red', title='prediction V1')\n",
    "    draw_box_set(axes[i, 3], v2['images'][i], v2['preds'][i]['boxes'].numpy(), color='orange', title='prediction V2')\n",
    "plt.tight_layout()\n",
