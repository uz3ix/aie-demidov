   "source": [
    "weights = models.detection.FasterRCNN_ResNet50_FPN_Weights.DEFAULT\n",
    "det_model = models.detection.fasterrcnn_resnet50_fpn(weights=weights).to(DEVICE)\n",
    "det_model.eval()\n",
    "\n",
    "@torch.inference_mode()\n",
    "def evaluate_detection(threshold, max_batches=10):\n",
    "    loader = DataLoader(kitti_val_ds, batch_size=2, shuffle=False, collate_fn=collate_detection)\n",
    "    total_tp, total_fp, total_fn = 0, 0, 0\n",
    "    matched_ious = []\n",
    "    example_images, example_targets, example_preds = None, None, None\n",
    "    for batch_idx, (images, targets) in enumerate(loader):\n",
    "        if batch_idx >= max_batches:\n",
    "            break\n",
    "        images_device = [img.to(DEVICE) for img in images]\n",
    "        outputs = det_model(images_device)\n",
    "        filtered_outputs = []\n",
    "        for out in outputs:\n",
    "            keep = out['scores'] >= threshold\n",
    "            filtered_outputs.append({\n",
    "                'boxes': out['boxes'][keep].cpu(),\n",
    "                'labels': out['labels'][keep].cpu(),\n",
    "                'scores': out['scores'][keep].cpu(),\n",
    "            })\n",
    "        if example_images is None:\n",
    "            example_images = [img.cpu() for img in images]\n",
    "            example_targets = [{k: v.cpu() for k, v in t.items()} for t in targets]\n",
    "            example_preds = filtered_outputs\n",
    "        for pred, target in zip(filtered_outputs, targets):\n",
    "            tp, fp, fn, ious = greedy_match(pred['boxes'], pred['labels'], target['boxes'], target['labels'], iou_threshold=0.5)\n",
    "            total_tp += tp\n",
    "            total_fp += fp\n",
    "            total_fn += fn\n",
    "            matched_ious.extend(ious)\n",
    "    precision = total_tp / (total_tp + total_fp + 1e-8)\n",
    "    recall = total_tp / (total_tp + total_fn + 1e-8)\n",
    "    mean_iou = float(np.mean(matched_ious)) if matched_ious else 0.0\n",
    "    return {\n",
    "        'precision': precision,\n",
    "        'recall': recall,\n",
    "        'mean_iou': mean_iou,\n",
    "        'images': example_images,\n",
    "        'targets': example_targets,\n",
    "        'preds': example_preds,\n",
    "    }\n",
    "\n",
    "v1 = evaluate_detection(0.3)\n",
    "v2 = evaluate_detection(0.7)\n",
    "\n",
    "append_run({\n",
    "    'experiment_id': 'V1', 'task': 'detection', 'dataset': 'KITTI', 'seed': SEED,\n",
    "    'model_summary': 'FasterRCNN_ResNet50_FPN pretrained', 'optimizer': '', 'lr': '', 'epochs_trained': 0,\n",
    "    'best_val_accuracy': '', 'test_accuracy': '', 'precision': round(v1['precision'], 6),\n",
    "    'recall': round(v1['recall'], 6), 'mean_iou': round(v1['mean_iou'], 6), 'notes': 'score_threshold=0.3'\n",
    "})\n",
    "append_run({\n",
    "    'experiment_id': 'V2', 'task': 'detection', 'dataset': 'KITTI', 'seed': SEED,\n",
    "    'model_summary': 'FasterRCNN_ResNet50_FPN pretrained', 'optimizer': '', 'lr': '', 'epochs_trained': 0,\n",
    "    'best_val_accuracy': '', 'test_accuracy': '', 'precision': round(v2['precision'], 6),\n",
